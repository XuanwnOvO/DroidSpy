<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-android35.0</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <RootNamespace>DroidSpy</RootNamespace>
    <AssemblyName>DroidSpy</AssemblyName>
    <ApplicationId>com.droidspy</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <!-- 本机工具链路径 -->
    <AndroidSdkDirectory>D:\Android\Sdk</AndroidSdkDirectory>
    <JavaSdkDirectory>C:\JDK\jdk-17.0.12</JavaSdkDirectory>

    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>

  <!-- 链接器只在 Release 启用；保留反编译引擎所需的反射元数据 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <!--
    正式签名。keystore 不放进仓库：本机开发时从环境变量读，
    没有就退回 Android SDK 自带的调试签名（CI 里用仓库 Secrets 注入）。
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(DROIDSPY_KEYSTORE)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(DROIDSPY_KEYSTORE)</AndroidSigningKeyStore>
    <AndroidSigningStorePass>$(DROIDSPY_STOREPASS)</AndroidSigningStorePass>
    <AndroidSigningKeyAlias>$(DROIDSPY_KEYALIAS)</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>$(DROIDSPY_KEYPASS)</AndroidSigningKeyPass>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ICSharpCode.Decompiler" Version="9.1.0.7988" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="SharpCompress" Version="0.39.0" />
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.14.0.6" />
  </ItemGroup>

</Project>
