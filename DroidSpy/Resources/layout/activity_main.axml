<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

  <com.google.android.material.appbar.MaterialToolbar
      android:id="@+id/toolbar"
      android:layout_width="match_parent"
      android:layout_height="?attr/actionBarSize"
      android:background="?attr/colorSurface"
      app:title="@string/app_name"
      app:titleTextColor="?attr/colorOnSurface" />

  <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1">

    <!-- ================= 页 1：首页 ================= -->
    <LinearLayout
        android:id="@+id/pageHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="20dp"
          android:paddingTop="8dp"
          android:paddingBottom="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_subtitle"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpen"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:text="@string/open_file"
            android:textSize="17sp"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_file"
            app:iconGravity="textStart"
            app:iconSize="26dp" />
      </LinearLayout>

      <TextView
          android:id="@+id/txtRecentHeader"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:paddingHorizontal="20dp"
          android:paddingTop="4dp"
          android:paddingBottom="8dp"
          android:text="@string/recent_files"
          android:textAppearance="?attr/textAppearanceTitleSmall"
          android:textColor="?attr/colorPrimary" />

      <TextView
          android:id="@+id/txtNoRecent"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:paddingHorizontal="20dp"
          android:paddingTop="6dp"
          android:text="@string/no_recent"
          android:textAppearance="?attr/textAppearanceBodyMedium"
          android:textColor="?attr/colorOnSurfaceVariant"
          android:visibility="gone" />

      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/recentList"
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1"
          android:clipToPadding="false"
          android:paddingBottom="16dp"
          android:scrollbars="vertical" />
    </LinearLayout>

    <!-- ================= 页 2：MCP ================= -->
    <ScrollView
        android:id="@+id/pageMcp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="20dp"
          android:paddingTop="12dp"
          android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mcp_intro"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

              <TextView
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:text="@string/mcp_service_title"
                  android:textAppearance="?attr/textAppearanceTitleMedium"
                  android:textColor="?attr/colorOnSurface" />

              <TextView
                  android:id="@+id/txtMcpState"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:background="@drawable/bg_badge"
                  android:paddingHorizontal="10dp"
                  android:paddingVertical="4dp"
                  android:text="@string/mcp_state_stopped"
                  android:textAppearance="?attr/textAppearanceLabelMedium"
                  android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="@string/mcp_port_label"
                  android:textAppearance="?attr/textAppearanceBodyMedium"
                  android:textColor="?attr/colorOnSurfaceVariant" />

              <EditText
                  android:id="@+id/editMcpPort"
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="12dp"
                  android:layout_weight="1"
                  android:autofillHints=""
                  android:hint="@string/mcp_port_label"
                  android:imeOptions="actionDone"
                  android:inputType="number"
                  android:maxLength="5"
                  android:maxLines="1"
                  android:text="1233"
                  android:textAppearance="?attr/textAppearanceBodyLarge"
                  android:textColor="?attr/colorOnSurface"
                  android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

              <com.google.android.material.button.MaterialButton
                  android:id="@+id/btnMcpToggle"
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:text="@string/mcp_btn_start"
                  app:cornerRadius="14dp"
                  app:icon="@drawable/ic_play" />

              <com.google.android.material.button.MaterialButton
                  android:id="@+id/btnMcpCopy"
                  style="@style/Widget.Material3.Button.TonalButton"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="12dp"
                  android:text="@string/mcp_copy_addr"
                  android:visibility="gone"
                  app:cornerRadius="14dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtMcpHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/mcp_need_assembly"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/mcp_caps_title"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/mcp_caps"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/txtMcpClientTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/mcp_client_title"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtMcpClient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_code_block"
            android:fontFamily="monospace"
            android:padding="14dp"
            android:textIsSelectable="true"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtMcpLocalTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/mcp_local_title"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtMcpLocalHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/mcp_local_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtMcpLocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_code_block"
            android:fontFamily="monospace"
            android:padding="14dp"
            android:textIsSelectable="true"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone" />
      </LinearLayout>
    </ScrollView>

    <!-- ================= 页 3：关于 ================= -->
    <ScrollView
        android:id="@+id/pageAbout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="20dp"
          android:paddingTop="24dp"
          android:paddingBottom="32dp">

        <!-- 抬头 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

          <com.google.android.material.imageview.ShapeableImageView
              android:layout_width="76dp"
              android:layout_height="76dp"
              android:background="?attr/colorPrimaryContainer"
              android:padding="16dp"
              android:scaleType="fitCenter"
              android:src="@drawable/ic_code"
              app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.DroidSpy.Squircle"
              app:tint="?attr/colorOnPrimaryContainer" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="14dp"
              android:text="@string/about_app_title"
              android:textAppearance="?attr/textAppearanceHeadlineSmall"
              android:textColor="?attr/colorOnSurface" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:text="@string/about_slogan"
              android:textAppearance="?attr/textAppearanceBodyMedium"
              android:textColor="?attr/colorPrimary" />

          <TextView
              android:id="@+id/txtVersion"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="6dp"
              android:textAppearance="?attr/textAppearanceLabelSmall"
              android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/about_desc"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- 能力清单 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_features_title"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="6dp"
                android:text="@string/about_features"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface" />
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 作者与爱人 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/about_credits_title"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorPrimary" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:padding="18dp">

            <!-- 作者 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

              <com.google.android.material.imageview.ShapeableImageView
                  android:id="@+id/imgAuthor"
                  android:layout_width="60dp"
                  android:layout_height="60dp"
                  android:background="?attr/colorSurfaceContainerHighest"
                  android:scaleType="centerCrop"
                  app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.DroidSpy.Circle" />

              <LinearLayout
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="14dp"
                  android:layout_weight="1"
                  android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                  <TextView
                      android:id="@+id/txtAuthorName"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="@string/about_author"
                      android:textAppearance="?attr/textAppearanceTitleMedium"
                      android:textColor="?attr/colorOnSurface" />

                  <TextView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_marginStart="8dp"
                      android:background="@drawable/bg_badge"
                      android:paddingHorizontal="8dp"
                      android:paddingVertical="2dp"
                      android:text="@string/about_author_role"
                      android:textAppearance="?attr/textAppearanceLabelSmall"
                      android:textColor="?attr/colorPrimary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtAuthorQq"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
              </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="?attr/colorOutlineVariant" />

            <!-- 爱人 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

              <com.google.android.material.imageview.ShapeableImageView
                  android:id="@+id/imgLover"
                  android:layout_width="60dp"
                  android:layout_height="60dp"
                  android:background="?attr/colorSurfaceContainerHighest"
                  android:scaleType="centerCrop"
                  app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.DroidSpy.Circle" />

              <LinearLayout
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="14dp"
                  android:layout_weight="1"
                  android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                  <TextView
                      android:id="@+id/txtLoverName"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="@string/about_lover"
                      android:textAppearance="?attr/textAppearanceTitleMedium"
                      android:textColor="?attr/colorOnSurface" />

                  <TextView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_marginStart="8dp"
                      android:background="@drawable/bg_badge"
                      android:paddingHorizontal="8dp"
                      android:paddingVertical="2dp"
                      android:text="@string/about_lover_role"
                      android:textAppearance="?attr/textAppearanceLabelSmall"
                      android:textColor="?attr/colorPrimary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtLoverQq"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
              </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefreshAvatar"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/about_refresh"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_refresh" />

            <TextView
                android:id="@+id/txtAvatarStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/about_links_title"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorPrimary" />

        <!-- 交流与反馈 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:paddingVertical="6dp">

            <!-- QQ 群 -->
            <LinearLayout
                android:id="@+id/rowQqGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp">

              <ImageView
                  android:layout_width="22dp"
                  android:layout_height="22dp"
                  android:contentDescription="@string/about_qq_group"
                  android:src="@drawable/ic_people"
                  app:tint="?attr/colorPrimary" />

              <LinearLayout
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="14dp"
                  android:layout_weight="1"
                  android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_qq_group"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/txtQqGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
              </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOutlineVariant" />

            <!-- GitHub 仓库 -->
            <LinearLayout
                android:id="@+id/rowGithub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp">

              <ImageView
                  android:layout_width="22dp"
                  android:layout_height="22dp"
                  android:contentDescription="@string/about_github"
                  android:src="@drawable/ic_link"
                  app:tint="?attr/colorPrimary" />

              <LinearLayout
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="14dp"
                  android:layout_weight="1"
                  android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_github"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/txtGithub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
              </LinearLayout>
            </LinearLayout>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 引用的开源库 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/about_libs_title"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorPrimary" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

          <LinearLayout
              android:id="@+id/libContainer"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:paddingVertical="6dp" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="@string/about_footer"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
      </LinearLayout>
    </ScrollView>
  </FrameLayout>

  <com.google.android.material.bottomnavigation.BottomNavigationView
      android:id="@+id/bottomNav"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="?attr/colorSurfaceContainer"
      app:menu="@menu/menu_main" />

</LinearLayout>
